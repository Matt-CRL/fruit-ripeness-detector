<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night resources resolve the light text-only name and Chami page
         background without changing the persisted app appearance setting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#101410</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/chami_name</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#101410</item>
    </style>
</resources>
